# Oracle connection used by the Express API. Put your username and password
# in a local .env file; never commit real credentials.
ORACLE_USER="YOUR_ORACLE_USERNAME"
ORACLE_PASSWORD=""
ORACLE_CONNECT_STRING="203.209.54.16:1521/database1"
API_PORT=3001
NODE_ENV=development

# Required only by npm run seed:dev; set a private local value (12+ characters).
DEV_SEED_PASSWORD=""

# Optional: only needed if a future feature calls Gemini.
GEMINI_API_KEY=""
